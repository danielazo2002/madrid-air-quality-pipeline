# Copy to .env and fill in. .env is ignored by git.

# Your user id on the host (run: id -u), so files written by containers belong to you.
AIRFLOW_UID=1000

# Encrypts connection passwords in the metadata database.
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=

# Signs the tokens Airflow components use to talk to each other.
# Generate with: openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=
